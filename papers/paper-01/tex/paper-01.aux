\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Relative deviation of the TCV-$\phi $ background expansion rate with respect to a reference $\Lambda $CDM cosmology with identical $(H_0,\Omega _{\rm  b} h^2,\Omega _{\rm  c} h^2,\Omega _\Lambda ,\Omega _{\rm  r})$. The plot shows $\mathcal  {R}_H(a) = H_{\rm  TCV}(a)/H_{\Lambda {\rm  CDM}}(a)$ as a function of $1/a = 1+z$. By construction the two models share the same effective density parameters, so $\mathcal  {R}_H(a)$ is numerically indistinguishable from unity over the range $10^{-4} \lesssim a \le 1$. This figure therefore acts mainly as a numerical sanity check of our CLASS interface and illustrates that, at the homogeneous level, the TCV-$\phi $ benchmark is exactly $\Lambda $CDM-like. }}{6}{figure.1}\protected@file@percent }
\newlabel{fig:Hratio}{{1}{6}{Relative deviation of the TCV-$\phi $ background expansion rate with respect to a reference $\Lambda $CDM cosmology with identical $(H_0,\Omega _{\rm b} h^2,\Omega _{\rm c} h^2,\Omega _\Lambda ,\Omega _{\rm r})$. The plot shows $\mathcal {R}_H(a) = H_{\rm TCV}(a)/H_{\Lambda {\rm CDM}}(a)$ as a function of $1/a = 1+z$. By construction the two models share the same effective density parameters, so $\mathcal {R}_H(a)$ is numerically indistinguishable from unity over the range $10^{-4} \lesssim a \le 1$. This figure therefore acts mainly as a numerical sanity check of our CLASS interface and illustrates that, at the homogeneous level, the TCV-$\phi $ benchmark is exactly $\Lambda $CDM-like}{figure.1}{}}
